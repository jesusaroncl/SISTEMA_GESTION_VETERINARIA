# Copia este archivo como .env en la VM y completa los valores:
#   cp .env.example .env

# URL pública del servidor (IP externa o dominio, SIN barra final)
# Ejemplo con IP:  http://35.123.45.67
# Ejemplo dominio: http://veterinaria.tudominio.com
NEXT_PUBLIC_API_BASE_URL=http://TU_IP_O_DOMINIO

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_DB=veterinaria_db

# Flask / JWT (genera valores aleatorios largos)
SECRET_KEY=cambia_esta_clave_secreta_flask
JWT_SECRET_KEY=cambia_esta_clave_jwt
