# Copia este archivo como .env en el servidor:
#   cp .env.example .env

# ── URL pública del BACKEND (la que usará el navegador) ──
# Debe coincidir con el Proxy Host de NPM apuntando al puerto del backend (BACKEND_PORT).
# SIN barra final. Usa HTTPS si NPM tiene SSL activo.
#
# Ejemplo con subdominio (recomendado):
#   NEXT_PUBLIC_API_BASE_URL=https://api.vet.tudominio.com
#
# Ejemplo solo IP en LAN:
#   NEXT_PUBLIC_API_BASE_URL=http://192.168.1.50:9000
NEXT_PUBLIC_API_BASE_URL=https://api.vet.tudominio.com

# Puertos expuestos en el servidor (Nginx Proxy Manager apunta aquí)
FRONTEND_PORT=7000
BACKEND_PORT=9000

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_DB=veterinaria_db

# ── Flask / JWT (genera valores aleatorios largos) ──
SECRET_KEY=cambia_esta_clave_secreta_flask
JWT_SECRET_KEY=cambia_esta_clave_jwt

# ── URL pública del frontend (enlaces de invitación) ──
FRONTEND_URL=https://sgv.baseq.pe

# ── Correo SMTP (invitaciones y recuperación de contraseña) ──
# Sin SMTP_HOST los correos no se envían: quedan en los logs del backend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Nginx Proxy Manager: crear 2 Proxy Hosts ──
#
# 1) Frontend
#    Domain:     vet.tudominio.com
#    Forward:    http://IP_DEL_SERVIDOR:7000
#    SSL:        Let's Encrypt (activar)
#    Websockets: ON (recomendado para Next.js)
#
# 2) Backend (API)
#    Domain:     api.vet.tudominio.com
#    Forward:    http://IP_DEL_SERVIDOR:9000
#    SSL:        Let's Encrypt (activar)
#
#    Pestaña Advanced → Custom Nginx Configuration (para análisis de audio):
#    proxy_read_timeout 180s;
#    proxy_send_timeout 180s;
#    client_max_body_size 50M;
#
# Después de editar NEXT_PUBLIC_API_BASE_URL, reconstruye el frontend:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build frontend
